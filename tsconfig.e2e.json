{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "e2e",
    "rootDir": "e2e",
    "types": ["node"]
  },
  "include": ["e2e/**/*.ts"],
  "exclude": ["node_modules", "e2e/**/*.js", "e2e/**/*.d.ts"]
}
